---
permalink: /archive/
eleventyExcludeFromCollections: true
title: Archive
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Archive · BTC Weekly</title>
<meta name="description" content="Every issue of BTC Weekly — weekly Bitcoin news digest.">
<link rel="canonical" href="{{ site.url }}/archive/">
<link rel="alternate" type="application/rss+xml" title="BTC Weekly" href="/feed.xml">
<meta property="og:title" content="Archive · BTC Weekly">
<meta property="og:description" content="Every issue of BTC Weekly — weekly Bitcoin news digest.">
<meta property="og:url" content="{{ site.url }}/archive/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="BTC Weekly">
<meta property="og:image" content="{{ site.url }}/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Archive · BTC Weekly">
<meta name="twitter:description" content="Every issue of BTC Weekly — weekly Bitcoin news digest.">
<meta name="twitter:image" content="{{ site.url }}/og.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "BTC Weekly Archive",
  "description": "Every issue of BTC Weekly — weekly Bitcoin news digest.",
  "url": "{{ site.url }}/archive/",
  "publisher": {
    "@type": "Organization",
    "name": "BTC Weekly",
    "url": "{{ site.url }}"
  }
}
</script>
<style>
@font-face {
  font-family: 'Black Han Sans';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/black-han-sans/black-han-sans-latin-400-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-400-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-700-normal.woff2') format('woff2');
}

:root {
  --orange:        #F7931A;
  --orange-bright: #FFAA3A;
  --orange-soft:   #FFBE5C;
  --orange-mist:   #FFD48C;
  --orange-pale:   #FFE8BE;
  --orange-faint:  #FFF5E6;
  --bg:            #FFF6EC;
  --white:         #FFFFFF;
  --surface-soft:  #FFF9F2;
  --border:        #EDDECC;
  --border-soft:   #F5E9D8;
  --text:          #1C1208;
  --muted:         #52402C;
  --faint:         #A08060;
  --shadow-sm:     0 1px 3px rgba(247,147,26,0.08), 0 1px 8px rgba(247,147,26,0.05);
  --text-label:    clamp(12px, 1.8vw, 13px);
  --text-meta:     clamp(13px, 2vw,   14px);
  --text-body:     clamp(15px, 2.2vw, 16px);
  --text-title:    clamp(17px, 2.6vw, 18px);
  --text-mark:     clamp(58px, 13vw,  96px);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { -webkit-font-smoothing:antialiased; }
body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); font-size:var(--text-body); line-height:1.65; min-height:100vh; }
a { color:var(--orange); text-decoration:none; transition:color 150ms; }
a:hover { color:var(--orange-bright); text-decoration:underline; }

.wrapper { max-width:660px; margin:0 auto; padding:0 20px 72px; }

.top-bar {
  background:var(--orange); padding:10px 20px; margin:0 -20px;
  display:flex; align-items:center; justify-content:space-between;
  box-shadow:0 3px 0 var(--orange-bright);
}
.top-bar-logo { height:28px; width:auto; flex-shrink:0; }
.top-bar-spacer { width:28px; flex-shrink:0; }
.top-bar-tagline { font-size:var(--text-label); font-weight:600; color:rgba(255,255,255,0.76); letter-spacing:0.06em; white-space:nowrap; }
.top-bar-tagline .hi { color:#fff; font-weight:700; }

.masthead-hero { padding:36px 0 0; }
.wordmark { font-family:'Black Han Sans',sans-serif; font-size:var(--text-mark); line-height:0.88; letter-spacing:0.02em; display:block; white-space:nowrap; font-size:clamp(32px, 11vw, 96px); }
.w1 { color:var(--orange); text-shadow:2px 2px 0 #FFAA3A,4px 4px 0 #FFBE5C,6px 6px 0 #FFD48C; }
.w2 { color:var(--text); -webkit-text-stroke:1.5px var(--orange); text-shadow:3px 3px 0 #FFE8BE,5px 5px 0 #FFD48C; }

.archive-heading {
  margin-top:28px; padding-bottom:12px;
  border-bottom:3px solid var(--orange);
  font-size:var(--text-title); font-weight:700; color:var(--text);
  letter-spacing:0.04em; text-transform:uppercase;
}

.archive-item {
  display:flex; align-items:flex-start; gap:14px;
  background:var(--white); border:1px solid var(--border);
  border-radius:10px; margin-top:10px; padding:16px 18px;
  box-shadow:var(--shadow-sm); text-decoration:none; color:inherit;
  transition:border-color 150ms;
}
.archive-item:hover { border-color:var(--orange-soft); text-decoration:none; }

.arc-pill {
  flex-shrink:0; background:var(--orange-faint); color:var(--orange);
  font-size:var(--text-label); font-weight:700; letter-spacing:0.1em; text-transform:uppercase;
  padding:4px 10px; border-radius:4px; border:1.5px solid var(--orange-pale);
  white-space:nowrap; margin-top:2px;
}
.arc-body { flex:1; min-width:0; }
.arc-date { font-size:var(--text-meta); color:var(--faint); margin-bottom:4px; }
.arc-title { font-size:var(--text-body); font-weight:600; color:var(--text); line-height:1.35; }
.arc-lead { font-size:var(--text-meta); color:var(--muted); margin-top:3px; line-height:1.45; }

.footer {
  text-align:center; padding:24px 0; border-top:1px solid var(--border-soft);
  margin-top:28px; font-size:var(--text-meta); color:var(--faint); line-height:2;
}
.footer a { color:var(--orange); }

@media(max-width:480px){
  .archive-item { flex-direction:column; gap:8px; }
}

/* ── DESIGN v2 (shared with issue pages) ── */
.wrapper { max-width:760px; }
.page-ribbon {
  position:relative; overflow:hidden; display:flex; align-items:center; gap:18px; flex-wrap:wrap;
  margin-top:34px; padding:18px 22px;
  background:linear-gradient(120deg, #F7931A, #FFAA3A); border-radius:16px;
  box-shadow:0 10px 26px rgba(247,147,26,0.30);
}
.page-ribbon::before {
  content:"₿"; position:absolute; right:24px; top:-30px; font-size:130px; font-weight:800;
  color:rgba(255,255,255,0.12); pointer-events:none;
}
.pr-title {
  position:relative; font-family:'Black Han Sans',sans-serif; font-weight:400;
  font-size:clamp(32px, 6vw, 50px); line-height:1; color:#fff; text-shadow:2px 2px 0 #C96F00; white-space:nowrap;
}
.pr-meta { position:relative; display:flex; flex-direction:column; }
.pr-meta b { font-size:20px; font-weight:800; color:#1C1208; line-height:1.1; }
.pr-meta span { margin-top:4px; font-size:12px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:rgba(28,18,8,0.75); }
[data-cat] { --c:var(--orange); --cb:var(--orange-faint); }
[data-cat="Regulation"]    { --c:#2F5D8A; --cb:#E6EEF7; }
[data-cat="Banking"]       { --c:#2E6B45; --cb:#E3F2E8; }
[data-cat="Institutional"] { --c:#6343A0; --cb:#EEE7F8; }
[data-cat="Mining"]        { --c:#8A5200; --cb:#FCEBD2; }
[data-cat="Research"]      { --c:#1C6E6E; --cb:#DFF2F1; }
[data-cat="Payments"]      { --c:#A8355A; --cb:#FBE6EC; }
[data-cat="Sovereign"]     { --c:#24406E; --cb:#E3E8F2; }
[data-cat="ETF"]           { --c:#7E4410; --cb:#F6E6D6; }

.arc-month {
  margin:30px 0 4px; font-family:'Black Han Sans',sans-serif; font-weight:400;
  font-size:22px; letter-spacing:0.04em; text-transform:uppercase; color:#1C1208;
  display:flex; align-items:center; gap:12px;
}
.arc-month::after { content:""; flex:1; height:2px; background:var(--orange-pale); border-radius:2px; }
.archive-item {
  display:flex; align-items:stretch; gap:0; padding:0; overflow:hidden;
  background:var(--white); border:none; border-radius:14px; margin-top:12px;
  box-shadow:0 6px 18px rgba(28,18,8,0.07); transition:transform 150ms, box-shadow 150ms;
}
.archive-item:hover { transform:translateY(-2px); box-shadow:0 10px 26px rgba(28,18,8,0.12); text-decoration:none; }
.arc-tile {
  flex:0 0 140px; min-width:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:14px 8px; background:linear-gradient(140deg, #F7931A, #FFAA3A); color:#fff; text-align:center;
}
.arc-tile-date { white-space:nowrap; font-family:'Black Han Sans',sans-serif; font-size:17px; line-height:1.1; text-shadow:1px 1px 0 #C96F00; }
.arc-tile-week { margin-top:6px; font-size:11px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:rgba(28,18,8,0.75); }
.arc-body { flex:1; min-width:0; padding:16px 20px; }
.arc-head { font-size:var(--text-title); font-weight:700; color:var(--text); line-height:1.3; }
.arc-lead { font-size:var(--text-meta); color:var(--muted); margin-top:4px; line-height:1.45; }
.arc-cats { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
.arc-cat { font-size:11px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; padding:3px 9px; border-radius:999px; color:var(--c); background:var(--cb); }
@media(max-width:480px){
  .archive-item { flex-direction:row; }
  .arc-tile { flex-basis:104px; padding:12px 6px; }
  .arc-tile-date { font-size:13px; }
  .arc-body { padding:14px 14px; }
}
</style>
</head>
<body>
<div class="wrapper">

  <header>
    <div class="top-bar">
      <a href="/"><img src="/images/logo.png" class="top-bar-logo" alt="BTC Weekly"></a>
      <div class="top-bar-tagline"><span class="hi">B</span>alanced · <span class="hi">T</span>rusted · <span class="hi">C</span>oncise</div>
      <div class="top-bar-spacer"></div>
    </div>
    <div class="masthead-hero">
      <div class="wordmark"><span class="w1">BTC</span>&thinsp;<span class="w2">WEEKLY</span></div>
    </div>
  </header>

  <div class="page-ribbon">
    <div class="pr-title">All issues</div>
    <div class="pr-meta"><b>{{ collections.issues | length }} issues</b><span>Every Saturday · newest first</span></div>
  </div>

  {% for group in collections.issues | groupByMonth %}
  <h2 class="arc-month">{{ group.label }}</h2>
  {% for issue in group.items %}
  {% set _rib = issue.data.dateRange | weekRibbon %}
  <a href="{{ issue.url }}" class="archive-item">
    <div class="arc-tile">
      <div class="arc-tile-date">{{ _rib.dates }}</div>
      <div class="arc-tile-week">Week {{ issue.data.week }}</div>
    </div>
    <div class="arc-body">
      {% if issue.data.headline %}
      <div class="arc-head">{{ issue.data.headline }}</div>
      {% if issue.data.top_stories and issue.data.top_stories[0] %}<div class="arc-lead">{{ issue.data.top_stories[0].title }}</div>{% endif %}
      {% elif issue.data.stories and issue.data.stories[0] %}
      <div class="arc-head">{{ issue.data.stories[0].title }}</div>
      {% else %}
      <div class="arc-head">{{ issue.data.title }}</div>
      {% endif %}
      <div class="arc-cats">{% for c in issue.data | issueCategories %}<span class="arc-cat" data-cat="{{ c }}">{{ c }}</span>{% endfor %}</div>
    </div>
  </a>
  {% endfor %}
  {% endfor %}

  <footer class="footer">
    <div><a href="/">btcweekly.org</a> · <a href="/archive/">Archive</a> · <a href="/health/">Health Meter</a> · <a href="/feed.xml">RSS</a></div>
    <div style="margin-top:6px">© 2026 BTC Weekly · Fix the money, fix the world</div>
  </footer>

</div>
</body>
</html>
