<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ (intro or (top_stories[0].what if top_stories and top_stories[0] else (stories[0].summary if stories and stories[0] else ""))) | truncate(160) }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/rss+xml" title="BTC Weekly" href="/feed.xml">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ (intro or (top_stories[0].what if top_stories and top_stories[0] else (stories[0].summary if stories and stories[0] else ""))) | truncate(200) }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="BTC Weekly">
<meta property="og:image" content="{{ site.url }}/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ (intro or (top_stories[0].what if top_stories and top_stories[0] else (stories[0].summary if stories and stories[0] else ""))) | truncate(200) }}">
<meta name="twitter:image" content="{{ site.url }}/og.png">
<link rel="icon" type="image/png" href="/images/logo.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "{{ title }}",
  "description": "{{ (intro or (top_stories[0].what if top_stories and top_stories[0] else (stories[0].summary if stories and stories[0] else ""))) | truncate(160) }}",
  "datePublished": "{{ page.date | dateToRfc3339 }}",
  "url": "{{ site.url }}{{ page.url }}",
  "publisher": {
    "@type": "Organization",
    "name": "BTC Weekly",
    "url": "{{ site.url }}/"
  }
}
</script>
<style>
/* Self-hosted fonts */
@font-face {
  font-family: 'Black Han Sans';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/black-han-sans/black-han-sans-latin-400-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-400-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-500-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-600-normal.woff2') format('woff2');
}
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/fonts/inter/inter-latin-700-normal.woff2') format('woff2');
}

:root {
  --orange:        #F7931A;
  --orange-bright: #FFAA3A;
  --orange-soft:   #FFBE5C;
  --orange-mist:   #FFD48C;
  --orange-pale:   #FFE8BE;
  --orange-faint:  #FFF5E6;

  --bg:            #FFF6EC;
  --white:         #FFFFFF;
  --surface-soft:  #FFF9F2;
  --border:        #EDDECC;
  --border-soft:   #F5E9D8;

  --text:          #1C1208;
  --muted:         #52402C;
  --faint:         #A08060;

  --shadow-sm:   0 1px 3px rgba(247,147,26,0.08), 0 1px 8px rgba(247,147,26,0.05);
  --shadow-lead: 0 2px 0 var(--orange-pale), 0 6px 24px rgba(247,147,26,0.12);

  --text-label: clamp(12px, 1.8vw, 13px);
  --text-meta:  clamp(13px, 2vw,   14px);
  --text-body:  clamp(15px, 2.2vw, 16px);
  --text-title: clamp(17px, 2.6vw, 18px);
  --text-lead:  clamp(20px, 3.2vw, 22px);
  --text-num:   clamp(24px, 3.8vw, 28px);
  --text-mark:  clamp(32px, 12vw,  96px);
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; scrollbar-gutter:stable; }
body {
  font-family:'Inter',sans-serif; background:var(--bg);
  color:var(--text); font-size:var(--text-body);
  line-height:1.65; min-height:100vh;
}
a { color:var(--orange); text-decoration:none; transition:color 150ms; }
a:hover { color:var(--orange-bright); text-decoration:underline; }

.wrapper { max-width:660px; margin:0 auto; padding:0 20px 72px; }

/* ── TOP BAR ── */
.top-bar {
  background:var(--orange); padding:10px 20px; margin:0 -20px;
  display:flex; align-items:center; justify-content:space-between;
  box-shadow:0 3px 0 var(--orange-bright);
}
.top-bar-tagline { font-size:var(--text-label); font-weight:600; color:rgba(255,255,255,0.76); letter-spacing:0.06em; white-space:nowrap; }
.top-bar-tagline .hi { color:#fff; font-weight:700; }
.top-bar-logo { height:28px; width:auto; flex-shrink:0; }
.top-bar-spacer { width:28px; flex-shrink:0; }

/* ── WORDMARK ── */
.masthead-hero { padding:36px 0 0; }
.footer-logo { height:auto; width:180px; display:block; margin:12px auto 4px; }
.wordmark {
  font-family:'Black Han Sans',sans-serif;
  font-size:var(--text-mark); line-height:0.88; letter-spacing:0.02em; display:block;
  white-space:nowrap;
}
.w1 {
  color:var(--orange);
  text-shadow:2px 2px 0 var(--orange-bright),4px 4px 0 var(--orange-soft),6px 6px 0 var(--orange-mist);
}
.w2 {
  color:var(--text);
  -webkit-text-stroke:1.5px var(--orange);
  text-shadow:3px 3px 0 var(--orange-pale),5px 5px 0 var(--orange-mist);
}

/* ── META ROW ── */
.meta-row {
  display:flex; align-items:center; justify-content:center;
  margin-top:16px; padding:13px 0;
}
.issue-pill-wrap { position:relative; display:inline-block; }
.issue-pill {
  background:var(--white); color:var(--orange);
  font-size:var(--text-label); font-weight:700; letter-spacing:0.1em; text-transform:uppercase;
  padding:6px 16px; border-radius:4px; white-space:nowrap;
  border:1.5px solid var(--orange); box-shadow:2px 2px 0 var(--orange-pale);
  cursor:pointer; font-family:inherit;
  display:flex; align-items:center; gap:8px;
  transition:background 150ms, color 150ms;
}
.issue-pill:hover { background:var(--orange-faint); }
.pill-chevron { transition:transform 150ms; flex-shrink:0; }
.issue-pill[aria-expanded="true"] .pill-chevron { transform:rotate(180deg); }
.issue-dropdown {
  position:absolute; top:calc(100% + 6px); left:50%; transform:translateX(-50%);
  background:var(--white); border:1.5px solid var(--orange); border-radius:8px;
  box-shadow:0 8px 24px rgba(0,0,0,0.13);
  width:max-content; z-index:200; overflow:hidden;
}
.issue-dropdown[hidden] { display:none; }
.issue-dropdown-item {
  display:block; padding:9px 16px; white-space:nowrap;
  font-size:var(--text-label); font-weight:700; letter-spacing:0.08em; text-transform:uppercase;
  color:var(--orange); text-decoration:none;
  border-bottom:1px solid var(--border-soft);
  transition:background 150ms;
}
.issue-dropdown-item:last-child { border-bottom:none; }
.issue-dropdown-item:hover { background:var(--orange-faint); text-decoration:none; }
.issue-dropdown-item.is-current {
  background:var(--orange-faint); color:var(--faint);
  cursor:default; pointer-events:none;
}

.sponsor { display:none; }

/* ── STORY CARD ── */
.story {
  display:flex; flex-direction:column;
  background:var(--white); border:1px solid var(--border);
  border-radius:10px; margin-top:10px;
  box-shadow:var(--shadow-sm);
  overflow:hidden;
}

/* Story #1 elevated */
.story.s1 {
  border-top:4px solid var(--orange);
  box-shadow:var(--shadow-lead);
}

@media (hover: hover) and (pointer: fine) {
  .story:hover    { border-color:var(--orange-soft); }
  .story.s1:hover { border-color:var(--orange-soft); border-top-color:var(--orange); }
}

/* ── STORY META BAR ── */
.story-meta {
  display:flex; align-items:center; gap:7px;
  padding:7px 16px;
  background:var(--surface-soft);
  border-bottom:1px solid var(--border-soft);
}
.story.s1 .story-meta {
  background:var(--orange-faint);
  border-bottom-color:var(--orange-pale);
}

.s-n {
  font-family:'Black Han Sans',sans-serif;
  font-size:var(--text-meta); line-height:1;
  color:var(--orange);
}

.s-meta-sep {
  color:var(--orange-soft);
  font-size:var(--text-label);
  line-height:1;
}

.s-cat {
  font-size:var(--text-label); font-weight:700; letter-spacing:0.14em; text-transform:uppercase;
  color:var(--orange);
}

/* ── STORY BODY ── */
.story-body { padding:16px 18px; }

.s-title { font-size:var(--text-title); font-weight:700; color:var(--text); line-height:1.32; }

.s-summary { font-size:var(--text-body); color:var(--muted); line-height:1.62; margin-top:7px; }
.s-consequence {
  margin-top:10px;
  padding:8px 12px;
  border-left:3px solid var(--orange-pale);
  background:var(--orange-faint);
  border-radius:0 4px 4px 0;
  font-size:var(--text-body);
  color:var(--muted);
  line-height:1.62;
}
.s-source {
  margin-top:10px; padding-top:10px; border-top:1px solid var(--border-soft);
  font-size:var(--text-meta); color:var(--faint); display:flex; align-items:center; gap:5px; flex-wrap:wrap;
}
.s-source a { color:var(--orange); font-weight:500; }

/* ── FORMAT 2: hero, labeled story parts, in brief ── */
.issue-hero {
  margin-top:20px; padding:18px 20px;
  background:linear-gradient(135deg, var(--orange-faint), var(--white));
  border:1px solid var(--border); border-left:4px solid var(--orange);
  border-radius:10px; box-shadow:var(--shadow-sm);
}
h1.issue-headline, h2.s-title, h2.brief-head { margin:0; }
p.s-part { margin-bottom:0; }
.issue-headline { font-size:clamp(24px, 4vw, 30px); font-weight:800; color:var(--text); line-height:1.22; letter-spacing:-0.01em; }
.issue-lead { margin:8px 0 0; font-size:var(--text-title); color:var(--text); line-height:1.55; font-style:normal; }
.s-part { font-size:var(--text-body); color:var(--muted); line-height:1.62; margin-top:9px; }
.s-label { font-weight:700; color:var(--text); }
.s-part .s-links a { color:var(--orange); font-weight:500; white-space:nowrap; display:inline-block; padding:11px 2px; margin:-11px -2px; }
.brief {
  margin-top:22px; background:var(--white); border:1px solid var(--border);
  border-radius:10px; box-shadow:var(--shadow-sm); overflow:hidden;
}
.brief-head {
  padding:9px 16px; background:var(--surface-soft); border-bottom:1px solid var(--border-soft);
  font-size:var(--text-label); font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--orange);
}
.brief-list { list-style:none; margin:0; padding:0; }
.brief-item { padding:12px 18px; border-bottom:1px solid var(--border-soft); font-size:var(--text-body); color:var(--muted); line-height:1.55; }
.brief-item:last-child { border-bottom:none; }
.brief-cat {
  display:block; font-size:var(--text-label); font-weight:700; letter-spacing:0.12em;
  text-transform:uppercase; color:var(--orange); margin-bottom:2px;
}
.brief-item a { color:var(--orange); font-weight:500; white-space:nowrap; display:inline-block; padding:11px 2px; margin:-11px -2px; }
.quiet { padding:10px 18px; font-size:var(--text-meta); color:var(--faint); border-top:1px solid var(--border-soft); background:var(--surface-soft); }

/* ── WEEKLY INTRO ── */
.issue-intro {
  margin-top:20px; padding:14px 18px;
  border-left:3px solid var(--orange);
  background:var(--orange-pale);
  border-radius:0 8px 8px 0;
  font-size:var(--text-body); color:var(--muted); line-height:1.65;
  font-style:italic;
}

/* ── RSS ── */
.rss {
  margin:28px 0 24px; background:var(--white);
  border:1px solid var(--border); border-radius:10px;
  padding:20px 22px; display:flex; align-items:center; gap:16px;
  box-shadow:var(--shadow-sm);
}
.rss-icon {
  width:42px; height:42px; background:var(--orange); color:#fff;
  border-radius:8px; display:flex; align-items:center; justify-content:center;
  flex-shrink:0; box-shadow:2px 2px 0 var(--orange-bright),3px 3px 0 var(--orange-soft);
}
.rss-title { font-size:var(--text-title); font-weight:700; color:var(--text); margin-bottom:3px; }
.rss-sub   { font-size:var(--text-body); color:var(--muted); }
.rss-link  { display:inline-block; margin-top:6px; color:var(--orange); font-weight:700; font-size:var(--text-meta); }
.rss-link:hover { color:var(--orange-bright); }

/* ── FOOTER ── */
.footer {
  text-align:center; padding:24px 0; border-top:1px solid var(--border-soft);
  font-size:var(--text-meta); color:var(--faint); line-height:2;
}
.footer a { color:var(--orange); }
.footer a:hover { color:var(--orange-bright); }


@media(max-width:480px){
  .meta-row { flex-direction:column; align-items:flex-start; gap:8px; }
  .rss { flex-direction:column; align-items:flex-start; }
}

/* ── HEALTH METER MINI ── */
.hm-mini {
  display:block; margin-top:14px;
  background:var(--white); border:1px solid var(--border);
  border-radius:10px; padding:14px 16px 12px;
  box-shadow:var(--shadow-sm);
  color:inherit; text-decoration:none;
  transition:border-color 150ms, box-shadow 150ms;
}
.hm-mini:hover { border-color:var(--orange-soft); box-shadow:0 2px 12px rgba(247,147,26,0.18); text-decoration:none; }
.hm-mini-label {
  font-size:var(--text-label); font-weight:700; letter-spacing:0.14em;
  text-transform:uppercase; color:var(--faint);
}
.hm-mini-cta {
  margin-top:12px; padding-top:10px;
  border-top:1px solid var(--border-soft);
  text-align:right;
  font-size:var(--text-meta); font-weight:700; color:var(--orange);
  letter-spacing:0.04em;
}
.hm-mini:hover .hm-mini-cta { color:var(--orange-bright); }
.hm-mini-composite { margin-top:8px; }
.hm-mini-comp-row { display:flex; align-items:baseline; gap:14px; }
.hm-mini-score {
  font-family:'Black Han Sans',sans-serif; font-size:clamp(36px, 8vw, 48px); line-height:1;
}
.hm-mini-status { font-size:var(--text-title); font-weight:700; }
.hm-mini-comp-bar {
  height:10px; background:var(--orange-faint); border-radius:5px;
  margin-top:8px; overflow:hidden;
  box-shadow:inset 0 1px 2px rgba(0,0,0,0.06);
}
.hm-mini-comp-fill { height:100%; border-radius:5px; transition:width 600ms; }
.hm-mini-subs {
  display:grid; grid-template-columns:repeat(5, 1fr); gap:8px;
  margin-top:14px; padding-top:12px;
  border-top:1px solid var(--border-soft);
}
.hm-mini-sub { min-width:0; }
.hm-mini-sub-top { display:flex; flex-direction:column; gap:2px; }
.hm-mini-sub-name {
  font-size:10px; font-weight:700; color:var(--faint);
  letter-spacing:0.04em; text-transform:uppercase;
  white-space:nowrap;
}
.hm-mini-sub-val {
  font-family:'Black Han Sans',sans-serif; font-size:18px; line-height:1;
}
.hm-mini-sub-bar {
  height:5px; background:var(--orange-faint); border-radius:3px;
  margin-top:6px; overflow:hidden;
}
.hm-mini-sub-fill { height:100%; border-radius:3px; }
@media(max-width:480px) {
  .hm-mini-subs { gap:6px; }
  .hm-mini-sub-name { font-size:9px; letter-spacing:0; }
  .hm-mini-sub-val { font-size:16px; }
}


/* ── DESIGN v2: dark feature hero, category colors, card grid ── */
[data-cat] { --c:var(--orange); --cb:var(--orange-faint); }
[data-cat="Regulation"]    { --c:#2F5D8A; --cb:#E6EEF7; }
[data-cat="Banking"]       { --c:#2E6B45; --cb:#E3F2E8; }
[data-cat="Institutional"] { --c:#6343A0; --cb:#EEE7F8; }
[data-cat="Mining"]        { --c:#8A5200; --cb:#FCEBD2; }
[data-cat="Research"]      { --c:#1C6E6E; --cb:#DFF2F1; }
[data-cat="Payments"]      { --c:#A8355A; --cb:#FBE6EC; }
[data-cat="Sovereign"]     { --c:#24406E; --cb:#E3E8F2; }
[data-cat="ETF"]           { --c:#7E4410; --cb:#F6E6D6; }

.wrapper { max-width:760px; }

.issue-hero {
  position:relative; overflow:hidden;
  background:#1C1208; border:none; border-radius:16px;
  padding:34px 34px 32px; box-shadow:0 18px 40px rgba(28,18,8,0.25);
}
.issue-hero::after {
  content:""; position:absolute; right:-80px; top:-80px; width:260px; height:260px; border-radius:50%;
  background:radial-gradient(circle, var(--orange) 0%, rgba(247,147,26,0) 70%); opacity:0.45; pointer-events:none;
}
.issue-headline { position:relative; color:#FFF6EC; font-size:clamp(28px, 4.6vw, 40px); line-height:1.12; }
.issue-lead { position:relative; color:rgba(255,246,236,0.86); font-size:clamp(16px, 2.3vw, 19px); margin-top:12px; }

.story {
  border:none; border-top:6px solid var(--c); border-radius:14px;
  margin-top:22px; box-shadow:0 6px 20px rgba(28,18,8,0.07);
}
.story.s1 { border-top:6px solid var(--c); box-shadow:0 10px 28px rgba(28,18,8,0.10); }
.story-meta, .story.s1 .story-meta { background:none; border-bottom:none; padding:18px 24px 0; }
.story .s-n { font-size:34px; color:var(--c); }
.story .s-meta-sep { display:none; }
.story .s-cat { display:inline-block; padding:3px 10px; border-radius:999px; color:var(--c); background:var(--cb); letter-spacing:0.1em; }
.story-body { padding:10px 24px 24px; }
.s-title { font-size:clamp(19px, 2.8vw, 23px); }
.story.s1 .s-title { font-size:clamp(22px, 3.4vw, 28px); }
.story .s-consequence { background:var(--cb); border-left:4px solid var(--c); color:var(--text); }

.brief { background:none; border:none; box-shadow:none; border-radius:0; margin-top:34px; overflow:visible; }
.brief-head { background:none; border:none; padding:0 0 10px; color:var(--text); font-size:15px; }
.brief-list { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.brief-item, .brief-item:last-child {
  background:var(--white); border:none; border-top:4px solid var(--c); border-radius:12px;
  box-shadow:0 4px 14px rgba(28,18,8,0.06); padding:16px 18px;
}
.brief-cat { display:table; padding:3px 10px; border-radius:999px; color:var(--c); background:var(--cb); letter-spacing:0.1em; margin-bottom:8px; }
.quiet { margin-top:14px; border:none; border-radius:10px; }

.hm-mini { background:#1C1208; border:none; border-radius:16px; margin-top:34px; }
.hm-mini-label, .hm-mini-sub-name { color:rgba(255,246,236,0.62); }
.hm-mini-subs, .hm-mini-cta { border-top-color:rgba(255,246,236,0.12); }
.hm-mini-comp-bar, .hm-mini-sub-bar { background:rgba(255,246,236,0.12); box-shadow:none; }

@media(max-width:600px) {
  .brief-list { grid-template-columns:1fr; }
  .issue-hero { padding:26px 22px; }
  .story-meta, .story.s1 .story-meta { padding:16px 18px 0; }
  .story-body { padding:10px 18px 20px; }
}

/* ── WEEK RIBBON (issue dates) ── */
.meta-row { display:block; padding:18px 0 0; margin-top:16px; }
.week-ribbon {
  position:relative; display:flex; align-items:center; gap:18px;
  background:linear-gradient(120deg, #F7931A, #FFAA3A); border-radius:16px;
  padding:14px 14px 14px 22px; box-shadow:0 10px 26px rgba(247,147,26,0.30);
}
.week-ribbon::before {
  content:"₿"; position:absolute; left:46%; top:-26px; font-size:124px; font-weight:800;
  color:rgba(255,255,255,0.10); pointer-events:none; overflow:hidden;
}
.wr-date {
  font-family:var(--wr-font, 'Inter', sans-serif); font-weight:var(--wr-weight, 800);
  font-size:clamp(34px, 6vw, 52px); line-height:1; letter-spacing:-0.02em;
  color:#FFFFFF; text-shadow:2px 2px 0 #C96F00; white-space:nowrap;
}
.wr-meta { display:flex; flex-direction:column; flex:1; min-width:0; }
.wr-year { font-weight:800; font-size:22px; line-height:1; color:#1C1208; }
.wr-span { white-space:nowrap; margin-top:5px; font-size:12px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:rgba(28,18,8,0.75); }
.wr-ctrl { display:flex; align-items:center; gap:6px; z-index:2; }
.wr-arrow {
  display:grid; place-items:center; width:42px; height:42px; border-radius:10px;
  background:rgba(255,255,255,0.28); color:#1C1208; font-size:24px; font-weight:700; text-decoration:none;
}
.wr-arrow:hover { background:rgba(255,255,255,0.5); text-decoration:none; }
.wr-arrow.off { opacity:0.35; }
.wr-week {
  display:flex; align-items:center; gap:8px; height:42px; padding:0 14px; white-space:nowrap;
  border:none; border-radius:10px; background:#1C1208; color:#FFF6EC; cursor:pointer;
  font-family:inherit; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase;
}
.wr-week[aria-expanded="true"] .pill-chevron { transform:rotate(180deg); }
.week-ribbon .issue-dropdown { left:auto; right:0; transform:none; top:calc(100% + 8px); max-height:60vh; overflow-y:auto; }
@media(max-width:600px) {
  .week-ribbon { flex-wrap:wrap; padding:16px 16px 14px; gap:10px 16px; }
  .week-ribbon::before { left:auto; right:-6px; }
  .wr-date { font-size:clamp(28px, 8.4vw, 40px); }
  .wr-span { display:none; }
  .wr-meta { flex:0 0 auto; }
  .wr-ctrl { width:100%; justify-content:space-between; }
  .wr-week { flex:1; justify-content:center; }
  .week-ribbon .issue-dropdown { left:0; right:0; width:auto; }
}
</style>
</head>
<body>
<div class="wrapper">

  <header>
    <div class="top-bar">
      <a href="/"><img src="/images/logo.png" class="top-bar-logo" alt="BTC Weekly"></a>
      <div class="top-bar-tagline"><span class="hi">B</span>alanced · <span class="hi">T</span>rusted · <span class="hi">C</span>oncise</div>
      <div class="top-bar-spacer"></div>
    </div>
    <div class="masthead-hero">
      <div class="wordmark"><span class="w1">BTC</span>&thinsp;<span class="w2">WEEKLY</span></div>
      {% set _rib = dateRange | weekRibbon %}
      {% set _nb = collections.issues | issueNeighbors(week, year) %}
      <div class="meta-row">
        <div class="week-ribbon">
          <div class="wr-date">{{ _rib.dates }}</div>
          <div class="wr-meta"><span class="wr-year">{{ _rib.year }}</span><span class="wr-span">Sunday – Saturday</span></div>
          <div class="wr-ctrl issue-pill-wrap">
            {% if _nb.prev %}<a class="wr-arrow" href="{{ _nb.prev.url }}" aria-label="Previous issue: Week {{ _nb.prev.data.week }}">‹</a>{% else %}<span class="wr-arrow off" aria-hidden="true">‹</span>{% endif %}
            <button class="wr-week" id="issue-btn" aria-haspopup="listbox" aria-expanded="false">
              Week {{ week }}
              <svg class="pill-chevron" width="11" height="7" viewBox="0 0 10 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4 4 4-4"/></svg>
            </button>
            {% if _nb.next %}<a class="wr-arrow" href="{{ _nb.next.url }}" aria-label="Next issue: Week {{ _nb.next.data.week }}">›</a>{% else %}<span class="wr-arrow off" aria-hidden="true">›</span>{% endif %}
            <div class="issue-dropdown" id="issue-dropdown" hidden>
            {% for issue in collections.issues %}
            <a href="{{ issue.url }}" class="issue-dropdown-item{% if issue.data.week == week and issue.data.year == year %} is-current{% endif %}">
              Week {{ issue.data.week }} · {{ issue.data.dateRange }}
            </a>
            {% endfor %}
          </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="sponsor"><!-- sponsor placeholder --></div>

  {% if top_stories %}
  <section class="issue-hero">
    {% if headline %}<h1 class="issue-headline">{{ headline }}</h1>{% endif %}
    {% if intro %}<p class="issue-lead">{{ intro }}</p>{% endif %}
  </section>

  {% for story in top_stories %}
  <article class="story{% if loop.first %} s1{% endif %}" data-cat="{{ story.category }}">
    <div class="story-meta">
      <span class="s-n">{{ loop.index }}</span>
      <span class="s-meta-sep">·</span>
      <span class="s-cat">{{ story.category }}</span>
    </div>
    <div class="story-body">
      <h2 class="s-title">{{ story.title }}</h2>
      <p class="s-part"><span class="s-label">What happened:</span> {{ story.what }}
        <span class="s-links">{% for src in story.sources %}<a href="{{ src.url }}">{{ src.label }}&nbsp;↗</a>{% if not loop.last %} · {% endif %}{% endfor %}</span></p>
      {% if story.why %}<div class="s-consequence"><span class="s-label">Why it matters:</span> {{ story.why }}</div>{% endif %}
    </div>
  </article>
  {% endfor %}

  {% if brief and brief.length or quiet and quiet.length %}
  <section class="brief">
    <h2 class="brief-head">This week in brief</h2>
    {% if brief and brief.length %}
    <ul class="brief-list">
      {% for item in brief %}
      <li class="brief-item" data-cat="{{ item.category }}"><span class="brief-cat">{{ item.category }}</span>{{ item.text }} <a href="{{ item.url }}">{{ item.source }}&nbsp;↗</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if quiet and quiet.length %}<div class="quiet">Quiet week: {{ quiet | join(", ") }}</div>{% endif %}
  </section>
  {% endif %}
  {% else %}
  {% if intro %}<div class="issue-intro">{{ intro }}</div>{% endif %}

  {% for story in stories %}
  <div class="story{% if loop.first %} s1{% endif %}" data-cat="{{ story.category }}">
    <div class="story-meta">
      <span class="s-n">{{ loop.index }}</span>
      <span class="s-meta-sep">·</span>
      <span class="s-cat">{{ story.category }}</span>
    </div>
    <div class="story-body">
      <div class="s-title">{{ story.title }}</div>
      <div class="s-summary">{{ story.summary }}</div>
      {% if story.consequence %}<div class="s-consequence">{{ story.consequence }}</div>{% endif %}
      <div class="s-source">
        ({% for src in story.sources %}<a href="{{ src.url }}">{{ src.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %})
      </div>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  {% if health %}
  {% macro _hcol(s) -%}
  {% if s == null %}#A08060{% elif s >= 80 %}#1f9e4a{% elif s >= 60 %}#5cb85c{% elif s >= 40 %}#FFAA3A{% elif s >= 20 %}#F7931A{% else %}#c9302c{% endif %}
  {%- endmacro %}
  {% set _hc = health.composite %}
  <a href="/health/" class="hm-mini">
    <div class="hm-mini-label">Bitcoin Health Meter</div>
    <div class="hm-mini-composite">
      <div class="hm-mini-comp-row">
        <span class="hm-mini-score" style="color:{{ _hcol(_hc) }}">{{ _hc | round }}</span>
        <span class="hm-mini-status" style="color:{{ _hcol(_hc) }}">{{ health.label }}</span>
      </div>
      <div class="hm-mini-comp-bar"><div class="hm-mini-comp-fill" style="width:{{ _hc }}%; background:{{ _hcol(_hc) }}"></div></div>
    </div>
    {% set _subs = [
      ["Network", health.subScores.network],
      ["Demand", health.subScores.demand],
      ["Holders", health.subScores.holders],
      ["Liquidity", health.subScores.liquidity],
      ["Leverage", health.subScores.leverage]
    ] %}
    <div class="hm-mini-subs">
      {% for s in _subs %}
      <div class="hm-mini-sub">
        <div class="hm-mini-sub-top">
          <span class="hm-mini-sub-name">{{ s[0] }}</span>
          <span class="hm-mini-sub-val" style="color:{{ _hcol(s[1]) }}">{{ s[1] | round if s[1] != null else "—" }}</span>
        </div>
        <div class="hm-mini-sub-bar"><div class="hm-mini-sub-fill" style="width:{{ s[1] if s[1] != null else 0 }}%; background:{{ _hcol(s[1]) }}"></div></div>
      </div>
      {% endfor %}
    </div>
    <div class="hm-mini-cta">View breakdown →</div>
  </a>
  {% endif %}

  <div class="rss">
    <div class="rss-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor"/></svg>
    </div>
    <div>
      <div class="rss-title">Follow via RSS</div>
      <div class="rss-sub">Your weekly roundup of Bitcoin's key developments. New issue every Saturday night.</div>
      <a href="/feed.xml" class="rss-link">btcweekly.org/feed.xml →</a>
    </div>
  </div>

  <footer class="footer">
    <div><a href="/">btcweekly.org</a> · <a href="/archive/">Archive</a> · <a href="/health/">Health Meter</a> · <a href="/feed.xml">RSS</a></div>
    <img src="/images/logo.png" class="footer-logo" alt="BTC Weekly">
    <div>© 2026 BTC Weekly · Fix the money, fix the world</div>
    <div>News search powered by <a href="https://brave.com/search/api/">Brave</a>{% if format == 2 %}. Summaries are written with AI help; each links to its source.{% endif %}</div>
  </footer>
</div>
<script>
(function(){
  var btn = document.getElementById('issue-btn');
  var dd  = document.getElementById('issue-dropdown');
  if (!btn || !dd) return;
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    dd.hidden = open;
  });
  document.addEventListener('click', function(){
    btn.setAttribute('aria-expanded', 'false');
    dd.hidden = true;
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape'){ btn.setAttribute('aria-expanded','false'); dd.hidden = true; }
  });
})();
</script>
</body>
</html>
