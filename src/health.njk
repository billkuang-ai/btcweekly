---
permalink: /health/
eleventyExcludeFromCollections: true
title: "Bitcoin Health Meter"
---
{% set h = health %}
{% set composite = h.composite %}
{% macro color(s) -%}
{% if s == null %}#A08060{% elif s >= 80 %}#1f9e4a{% elif s >= 60 %}#5cb85c{% elif s >= 40 %}#FFAA3A{% elif s >= 20 %}#F7931A{% else %}#c9302c{% endif %}
{%- endmacro %}
{% macro info(text) -%}
<span class="hm-info-wrap"><button type="button" class="hm-info" aria-label="How this is scored">i</button><span class="hm-info-tooltip" role="tooltip">{{ text }}</span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bitcoin Health Meter · BTC Weekly</title>
<meta name="description" content="Whether Bitcoin's network security, demand, holder base and liquidity are strengthening or weakening. Seven free data streams, updated daily.">
<link rel="canonical" href="{{ site.url }}/health/">
<link rel="alternate" type="application/rss+xml" title="BTC Weekly" href="/feed.xml">
<meta property="og:title" content="Bitcoin Health Meter · BTC Weekly">
<meta property="og:description" content="Whether Bitcoin's network security, demand, holder base and liquidity are strengthening or weakening. Seven free data streams, updated daily.">
<meta property="og:url" content="{{ site.url }}/health/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="BTC Weekly">
<meta property="og:image" content="{{ site.url }}/og.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="/images/logo.png">
<style>
@font-face { font-family:'Black Han Sans'; font-weight:400; font-display:swap; src:url('/fonts/black-han-sans/black-han-sans-latin-400-normal.woff2') format('woff2'); }
@font-face { font-family:'Inter'; font-weight:400; font-display:swap; src:url('/fonts/inter/inter-latin-400-normal.woff2') format('woff2'); }
@font-face { font-family:'Inter'; font-weight:600; font-display:swap; src:url('/fonts/inter/inter-latin-600-normal.woff2') format('woff2'); }
@font-face { font-family:'Inter'; font-weight:700; font-display:swap; src:url('/fonts/inter/inter-latin-700-normal.woff2') format('woff2'); }

:root {
  --orange:#F7931A; --orange-bright:#FFAA3A; --orange-soft:#FFBE5C;
  --orange-mist:#FFD48C; --orange-pale:#FFE8BE; --orange-faint:#FFF5E6;
  --bg:#FFF6EC; --white:#FFFFFF; --surface-soft:#FFF9F2;
  --border:#EDDECC; --border-soft:#F5E9D8;
  --text:#1C1208; --muted:#52402C; --faint:#A08060;
  --shadow-sm:0 1px 3px rgba(247,147,26,0.08), 0 1px 8px rgba(247,147,26,0.05);
  --shadow-lead:0 2px 0 var(--orange-pale), 0 6px 24px rgba(247,147,26,0.12);
  --text-label:clamp(12px,1.8vw,13px); --text-meta:clamp(13px,2vw,14px);
  --text-body:clamp(15px,2.2vw,16px); --text-title:clamp(17px,2.6vw,18px);
  --text-lead:clamp(20px,3.2vw,22px); --text-num:clamp(24px,3.8vw,28px);
  --text-mark:clamp(58px,13vw,96px);
}
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { -webkit-font-smoothing:antialiased; }
body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); font-size:var(--text-body); line-height:1.65; min-height:100vh; }
a { color:var(--orange); text-decoration:none; transition:color 150ms; }
a:hover { color:var(--orange-bright); text-decoration:underline; }

.wrapper { max-width:660px; margin:0 auto; padding:0 20px 72px; }
.top-bar { background:var(--orange); padding:10px 20px; margin:0 -20px; display:flex; align-items:center; justify-content:space-between; box-shadow:0 3px 0 var(--orange-bright); }
.top-bar-logo { height:28px; width:auto; flex-shrink:0; }
.top-bar-spacer { width:28px; flex-shrink:0; }
.top-bar-tagline { font-size:var(--text-label); font-weight:600; color:rgba(255,255,255,0.76); letter-spacing:0.06em; white-space:nowrap; }
.top-bar-tagline .hi { color:#fff; font-weight:700; }
.masthead-hero { padding:36px 0 0; }
.wordmark { font-family:'Black Han Sans',sans-serif; font-size:var(--text-mark); line-height:0.88; letter-spacing:0.02em; display:block; }
.w1 { color:var(--orange); text-shadow:2px 2px 0 #FFAA3A,4px 4px 0 #FFBE5C,6px 6px 0 #FFD48C; }
.w2 { color:var(--text); -webkit-text-stroke:1.5px var(--orange); text-shadow:3px 3px 0 #FFE8BE,5px 5px 0 #FFD48C; }
.page-heading { margin-top:28px; padding-bottom:12px; border-bottom:3px solid var(--orange); font-size:var(--text-title); font-weight:700; letter-spacing:0.04em; text-transform:uppercase; }

.hm-intro { margin-top:14px; padding:14px 18px; border-left:3px solid var(--orange); background:var(--orange-pale); border-radius:0 8px 8px 0; font-size:var(--text-body); color:var(--muted); line-height:1.65; font-style:italic; }
.hm-hero { background:var(--white); border:1px solid var(--border); border-radius:12px; box-shadow:var(--shadow-lead); padding:28px 22px 22px; margin-top:14px; text-align:center; }
.hm-hero-label { font-size:var(--text-label); font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--faint); }

/* Thermometer */
.therm-wrap { display:flex; gap:24px; align-items:center; justify-content:center; padding:18px 0 6px; }
.therm-body { position:relative; width:74px; height:300px; }
.therm-tube { position:absolute; left:50%; top:0; transform:translateX(-50%); width:34px; height:260px; background:var(--orange-faint); border:2px solid var(--orange); border-radius:18px; overflow:hidden; }
.therm-fill {
  position:absolute; bottom:0; left:0; right:0;
  background-image:linear-gradient(to top, #c9302c 0%, #F7931A 32%, #FFD93C 55%, #8BC34A 72%, #1f9e4a 100%);
  background-size:100% 256px;
  background-position:0 bottom;
  background-repeat:no-repeat;
}
.therm-bulb { position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:58px; height:58px; border:4px solid var(--orange); border-radius:50%; z-index:2; background:#fff; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.therm-bulb img { width:78%; height:78%; object-fit:contain; }
.therm-scale { display:flex; flex-direction:column; justify-content:space-between; height:260px; padding:4px 0; font-size:11px; color:var(--faint); font-weight:700; letter-spacing:0.08em; text-transform:uppercase; }
.therm-scale-row { display:flex; align-items:center; gap:8px; }
.therm-scale .tick { width:10px; height:1px; background:var(--faint); }
.therm-scale .therm-scale-row.active { color:var(--text); }
.therm-scale .therm-scale-row.active .tick { background:var(--text); height:2px; width:14px; }

.hm-hero-num { font-family:'Black Han Sans',sans-serif; font-size:clamp(56px,14vw,96px); line-height:1; margin:14px 0 2px; }
.hm-hero-status { font-size:var(--text-lead); font-weight:700; }
.hm-hero-meta { font-size:var(--text-meta); color:var(--faint); margin-top:8px; }
.hm-spot { font-size:var(--text-meta); color:var(--muted); margin-top:4px; }
.hm-hero-explain { font-size:var(--text-meta); color:var(--muted); line-height:1.55; margin:14px auto 0; padding-top:12px; border-top:1px solid var(--border-soft); max-width:480px; }
.hm-hero-explain strong { color:var(--text); }

.hm-section-label { margin-top:22px; padding:0 4px; font-size:var(--text-label); font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--faint); }

.hm-sub-grid { display:grid; gap:10px; margin-top:10px; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); }
.hm-sub { background:var(--white); border:1px solid var(--border); border-radius:10px; padding:14px 16px; box-shadow:var(--shadow-sm); }
.hm-sub-name { font-size:var(--text-label); font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--faint); }
.hm-sub-num { font-family:'Black Han Sans',sans-serif; font-size:var(--text-num); line-height:1; margin-top:6px; }
.hm-sub-bar { height:6px; background:var(--orange-faint); border-radius:3px; margin-top:10px; overflow:hidden; }
.hm-sub-bar-fill { height:100%; border-radius:3px; }
.hm-sub-note { font-size:var(--text-meta); color:var(--faint); margin-top:6px; }

.hm-input { background:var(--white); border:1px solid var(--border); border-radius:10px; padding:14px 16px; margin-top:10px; box-shadow:var(--shadow-sm); }
.hm-input-row { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
.hm-input-name { font-size:var(--text-title); font-weight:700; color:var(--text); display:flex; align-items:center; flex-wrap:wrap; gap:2px; }

/* Info button + tooltip */
.hm-info-wrap { position:relative; display:inline-flex; }
.hm-info {
  display:inline-flex; align-items:center; justify-content:center;
  width:18px; height:18px; margin-left:6px;
  background:var(--orange-faint); color:var(--orange);
  border:1.5px solid var(--orange-pale); border-radius:50%;
  font-family:inherit; font-size:11px; font-weight:700;
  cursor:pointer; padding:0; line-height:1;
  transition:all 150ms;
}
.hm-info:hover, .hm-info-wrap[aria-expanded="true"] .hm-info {
  background:var(--orange); color:#fff; border-color:var(--orange);
}
.hm-info-tooltip {
  position:absolute; left:50%; top:calc(100% + 8px);
  transform:translateX(-50%);
  width:min(240px, calc(100vw - 32px)); z-index:10;
  background:var(--text); color:#fff;
  padding:10px 12px; border-radius:8px;
  font-size:13px; font-weight:400; line-height:1.5;
  letter-spacing:0; text-transform:none;
  box-shadow:0 6px 20px rgba(0,0,0,0.18);
  pointer-events:none; opacity:0;
  transition:opacity 150ms;
}
.hm-info-wrap:hover .hm-info-tooltip,
.hm-info-wrap[aria-expanded="true"] .hm-info-tooltip {
  opacity:1; pointer-events:auto;
}
.hm-input-score { font-family:'Black Han Sans',sans-serif; font-size:var(--text-num); line-height:1; }
.hm-input-val { font-size:var(--text-body); color:var(--muted); margin-top:4px; }
.hm-input-note { font-size:var(--text-meta); color:var(--faint); margin-top:6px; }

.hm-methodology { margin-top:20px; padding:14px 18px; background:var(--surface-soft); border:1px solid var(--border-soft); border-radius:10px; font-size:var(--text-meta); color:var(--muted); line-height:1.6; }
.hm-methodology strong { color:var(--text); }

.footer { text-align:center; padding:24px 0; border-top:1px solid var(--border-soft); margin-top:28px; font-size:var(--text-meta); color:var(--faint); line-height:2; }
.footer a { color:var(--orange); }
</style>
</head>
<body>
<div class="wrapper">

  <header>
    <div class="top-bar">
      <a href="/"><img src="/images/logo.png" class="top-bar-logo" alt="BTC Weekly"></a>
      <div class="top-bar-tagline"><span class="hi">B</span>alanced · <span class="hi">T</span>rusted · <span class="hi">C</span>oncise</div>
      <div class="top-bar-spacer"></div>
    </div>
    <div class="masthead-hero">
      <div class="wordmark"><span class="w1">BTC</span>&thinsp;<span class="w2">WEEKLY</span></div>
    </div>
  </header>

  <h2 class="page-heading">Bitcoin Health Meter</h2>

  <div class="hm-hero">
    <div class="hm-hero-label">Composite Score</div>
    <div class="therm-wrap">
      <div class="therm-body">
        <div class="therm-tube"><div class="therm-fill" style="height:{{ composite }}%"></div></div>
        <div class="therm-bulb" style="border-color:{{ color(composite) }}"><img src="/images/logo.png" alt=""></div>
      </div>
      <div class="therm-scale">
        <div class="therm-scale-row{% if composite >= 80 %} active{% endif %}"><div class="tick"></div>Robust</div>
        <div class="therm-scale-row{% if composite >= 60 and composite < 80 %} active{% endif %}"><div class="tick"></div>Healthy</div>
        <div class="therm-scale-row{% if composite >= 40 and composite < 60 %} active{% endif %}"><div class="tick"></div>Mixed</div>
        <div class="therm-scale-row{% if composite >= 20 and composite < 40 %} active{% endif %}"><div class="tick"></div>Strained</div>
        <div class="therm-scale-row{% if composite < 20 %} active{% endif %}"><div class="tick"></div>Fragile</div>
      </div>
    </div>
    <div class="hm-hero-num" style="color:{{ color(composite) }}">{{ composite | round }}</div>
    <div class="hm-hero-status" style="color:{{ color(composite) }}">{{ h.label }}</div>
    <div class="hm-hero-meta">As of {{ h.date }} · 50 = a typical day of the last two years</div>
    <div class="hm-hero-explain"><strong>Robust</strong> = miners adding capacity, companies and US buyers accumulating, coins leaving exchanges, new dollars arriving, leverage calm. <strong>Fragile</strong> = the opposite. Not a price signal.</div>
  </div>

  <div class="hm-intro">
    Tracks whether Bitcoin's network security, demand, holder base and liquidity are strengthening or weakening. Seven free, public data streams, measured in Bitcoin's own units where possible. Refreshes daily.
  </div>

  <div class="hm-section-label">Sub-scores</div>
  <div class="hm-sub-grid">
    {% set subs = [
      ["Network", h.subScores.network, "Hashrate trend · fee share"],
      ["Demand", h.subScores.demand, "Corporate BTC added · Coinbase premium"],
      ["Holders", h.subScores.holders, "Exchange balances"],
      ["Liquidity", h.subScores.liquidity, "Stablecoin supply"],
      ["Leverage", h.subScores.leverage, "Perp funding"]
    ] %}
    {% for s in subs %}
    <div class="hm-sub">
      <div class="hm-sub-name">{{ s[0] }}</div>
      <div class="hm-sub-num" style="color:{{ color(s[1]) }}">{{ s[1] | round if s[1] != null else "—" }}</div>
      <div class="hm-sub-bar"><div class="hm-sub-bar-fill" style="width:{{ s[1] if s[1] != null else 0 }}%; background:{{ color(s[1]) }}"></div></div>
      <div class="hm-sub-note">{{ s[2] }}</div>
    </div>
    {% endfor %}
  </div>

  <div class="hm-section-label">Inputs</div>
  {% set i = h.inputs %}
  {% macro sign(n) %}{% if n >= 0 %}+{% endif %}{% endmacro %}
  {% macro stale(x) %}{% if x.stale %} · <em>carried forward from {{ x.asOf }}</em>{% endif %}{% endmacro %}

  {% if i.hashTrend.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Hashrate Trend (30d vs 90d){{ info("Average mining power over the last 30 days divided by the last 90. Above 1 means miners are plugging in more machines.") }}</div><div class="hm-input-score" style="color:{{ color(i.hashTrend.score) }}">{{ i.hashTrend.score | round }}</div></div>
    <div class="hm-input-val">Ratio {{ i.hashTrend.raw | round(3) }}{% if i.hashTrend.ma30EH %} · 30d avg {{ i.hashTrend.ma30EH | round }} EH/s{% endif %}{{ stale(i.hashTrend) }}</div>
    <div class="hm-input-note">{{ i.hashTrend.source }} — ranked against the last two years</div>
  </div>
  {% endif %}

  {% if i.feeShare.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Fee Share of Miner Revenue (30d){{ info("Transaction fees as a share of what miners earn; the rest is new issuance, which halves every four years. Higher means more demand for block space and a security budget less dependent on the subsidy.") }}</div><div class="hm-input-score" style="color:{{ color(i.feeShare.score) }}">{{ i.feeShare.score | round }}</div></div>
    <div class="hm-input-val">{{ i.feeShare.raw | round(2) }}% of miner revenue{{ stale(i.feeShare) }}</div>
    <div class="hm-input-note">{{ i.feeShare.source }} — ranked against the last two years</div>
  </div>
  {% endif %}

  {% if i.corp30.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Corporate BTC Added (30d){{ info("Net bitcoin added over 30 days by the largest public-company treasuries, counted in BTC rather than dollars, so it reflects buying, not price.") }}</div><div class="hm-input-score" style="color:{{ color(i.corp30.score) }}">{{ i.corp30.score | round }}</div></div>
    <div class="hm-input-val">{{ sign(i.corp30.raw) }}{{ (i.corp30.raw | round).toLocaleString("en-US") }} BTC{% if i.corp30.trackedCompanies %} · {{ i.corp30.trackedCompanies }} companies tracked{% endif %}{{ stale(i.corp30) }}</div>
    <div class="hm-input-note">{{ i.corp30.source }} public treasuries</div>
  </div>
  {% endif %}

  {% if i.premium7.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Coinbase Premium (7d){{ info("Coinbase's BTC-USD price versus OKX's BTC-USDT price. A positive gap means US buyers, including the custody flows behind spot ETFs, are bidding harder than the offshore market.") }}</div><div class="hm-input-score" style="color:{{ color(i.premium7.score) }}">{{ i.premium7.score | round }}</div></div>
    <div class="hm-input-val">{{ sign(i.premium7.raw) }}{{ i.premium7.raw | round(3) }}%{{ stale(i.premium7) }}</div>
    <div class="hm-input-note">{{ i.premium7.source }} daily closes — ranked against the last two years</div>
  </div>
  {% endif %}

  {% if i.exchFlow.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Exchange Balances (30d Δ){{ info("Bitcoin held in exchange wallets, change over 30 days. Coins leaving exchanges are usually being held; coins arriving are usually there to be sold. Falling balances score higher.") }}</div><div class="hm-input-score" style="color:{{ color(i.exchFlow.score) }}">{{ i.exchFlow.score | round }}</div></div>
    <div class="hm-input-val">{{ sign(i.exchFlow.raw) }}{{ i.exchFlow.raw | round(2) }}%{% if i.exchFlow.exchangeBTC %} · {{ (i.exchFlow.exchangeBTC | round).toLocaleString("en-US") }} BTC on exchanges{% endif %}{{ stale(i.exchFlow) }}</div>
    <div class="hm-input-note">{{ i.exchFlow.source }} — exchange wallets are estimated by address labelling</div>
  </div>
  {% endif %}

  {% if i.stable30.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Stablecoin Supply (30d Δ){{ info("Total supply of all USD stablecoins, change over 30 days. New stablecoins are new dollars entering crypto; shrinking supply means dollars leaving.") }}</div><div class="hm-input-score" style="color:{{ color(i.stable30.score) }}">{{ i.stable30.score | round }}</div></div>
    <div class="hm-input-val">{% if i.stable30.totalUSD %}${{ (i.stable30.totalUSD / 1000000000) | round(1) }}B · {% endif %}{{ sign(i.stable30.raw) }}{{ i.stable30.raw | round(2) }}%{{ stale(i.stable30) }}</div>
    <div class="hm-input-note">{{ i.stable30.source }} (all USD stablecoins) — ranked against the last two years</div>
  </div>
  {% endif %}

  {% if i.funding7.score != null %}
  <div class="hm-input">
    <div class="hm-input-row"><div class="hm-input-name">Perp Funding (7d, annualized){{ info("What leveraged traders pay to hold perpetual futures. Near zero to mildly positive is calm. Very positive means crowded longs; very negative means forced unwinding. Both extremes score low.") }}</div><div class="hm-input-score" style="color:{{ color(i.funding7.score) }}">{{ i.funding7.score | round }}</div></div>
    <div class="hm-input-val">{{ sign(i.funding7.raw) }}{{ i.funding7.raw | round(2) }}%{{ stale(i.funding7) }}</div>
    <div class="hm-input-note">{{ i.funding7.source }} BTC perpetual — fixed scale, best between 0% and 8%</div>
  </div>
  {% endif %}

  {% if h.context and (h.context.strategyBtc or h.context.strcPrice) %}
  <div class="hm-section-label">Context (not scored)</div>
  <div class="hm-input">
    <div class="hm-input-val">{% if h.context.strategyBtc %}Strategy holds {{ h.context.strategyBtc.toLocaleString("en-US") }} BTC{% endif %}{% if h.context.mNav %} · mNAV {{ h.context.mNav | round(2) }}×{% endif %}{% if h.context.strcPrice %} · STRC ${{ h.context.strcPrice | round(2) }} vs $100 par{% endif %}</div>
    <div class="hm-input-note">Shown for reference. Share-price ratios move with BTC, so they are not part of the score; Strategy's actual purchases count through Corporate BTC Added.</div>
  </div>
  {% endif %}

  <div class="hm-methodology">
    <strong>Methodology.</strong> Seven inputs roll up into five sub-scores: Network 25%, Demand 30%, Holders 20%, Liquidity 15%, Leverage 10%. Each input is ranked against its own last two years, so 50 means a typical day and 90 means stronger than 90% of them. Funding is the exception: it uses a fixed scale where calm positioning scores highest. The weighted total is smoothed over about a week and ranked against its own two-year history, so each label covers roughly a fifth of days. Code: <code>scripts/fetch-health-meter.js</code>.
    <br><br>
    <strong>Not a price signal.</strong> Inputs count actions — machines plugged in, bitcoin bought, coins withdrawn, stablecoins minted — in Bitcoin's own units where possible. Sentiment and valuation measures are excluded. Some link to price is unavoidable, so every run checks how closely the meter's weekly change tracks BTC's weekly return{% if h.priceCheck %}: currently {{ h.priceCheck.weekly }} over the last {{ h.priceCheck.days }} days{% endif %}.
    <br><br>
    <strong>Limits.</strong> Corporate holdings cover the 25 largest public companies, with one year of history. Spot ETF flows are not included because no free source is reliable enough. Exchange balances rely on address labelling and are estimates.
    <br><br>
    <strong>Sources.</strong> CoinMetrics community · mempool.space · CoinGecko · Coinbase · OKX · Deribit · DefiLlama.
  </div>

<script>
(function(){
  var wraps = document.querySelectorAll('.hm-info-wrap');
  function closeAll(){ wraps.forEach(function(w){ w.setAttribute('aria-expanded','false'); }); }
  function position(wrap){
    var tip = wrap.querySelector('.hm-info-tooltip');
    tip.style.transform = 'translateX(-50%)';
    var r = tip.getBoundingClientRect();
    var pad = 10;
    var shift = 0;
    if (r.right > window.innerWidth - pad) shift = -(r.right - (window.innerWidth - pad));
    else if (r.left < pad) shift = pad - r.left;
    if (shift) tip.style.transform = 'translateX(calc(-50% + ' + shift + 'px))';
  }
  wraps.forEach(function(wrap){
    wrap.setAttribute('aria-expanded','false');
    var btn = wrap.querySelector('.hm-info');
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var open = wrap.getAttribute('aria-expanded') === 'true';
      closeAll();
      if (!open) { wrap.setAttribute('aria-expanded','true'); position(wrap); }
    });
    wrap.addEventListener('mouseenter', function(){ position(wrap); });
  });
  document.addEventListener('click', closeAll);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeAll(); });
  window.addEventListener('resize', closeAll);
})();
</script>

  <footer class="footer">
